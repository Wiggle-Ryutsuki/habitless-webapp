# ==============================================================================
# HabitLess - Root Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env (or use server/.env) for local development.
# NEVER commit real passwords, secrets, or connection strings to Git.
# In production on Google Cloud Platform, sensitive secrets are injected via
# GCP Secret Manager, and runtime variables are set in Cloud Run.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Runtime Settings
# ------------------------------------------------------------------------------
# Port the Express server listens on. Cloud Run overrides this dynamically via PORT.
PORT=3000

# Runtime environment ('development', 'test', 'production').
# In production, strict security guards prevent fallback passwords.
NODE_ENV=development

# ------------------------------------------------------------------------------
# Database Connection (Persistent Storage)
# ------------------------------------------------------------------------------
# PostgreSQL connection string with schema.
# Local: connect to Docker PostgreSQL container.
# Production: sourced from GCP Secret Manager connecting to Cloud SQL via unix socket.
DATABASE_URL="postgresql://habitless_user:change-me-db-password@localhost:5432/habitless_dev?schema=public"

# ------------------------------------------------------------------------------
# Authentication & Security Secrets
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JWT tokens (minimum 32 characters).
# Production: sourced from GCP Secret Manager.
JWT_SECRET="change-me-to-a-secure-random-secret-at-least-32-chars"

# ------------------------------------------------------------------------------
# Database Seed Configuration (Episode 2: Safe Production Seed)
# ------------------------------------------------------------------------------
# Initial password for the seeded Program Manager (manager@habitless.internal).
# Mandatory when NODE_ENV=production. Sourced from Secret Manager in production.
ADMIN_PASSWORD="change-me-admin-password"

# Toggle seeding of demo participants, sample habits, logs, and challenge programs.
# Default: true locally. In production, set to false for clean deploy or true for UAT.
SEED_DEMO_DATA=true

# Password assigned to seeded demo participant accounts (participant1, participant2).
# Mandatory when SEED_DEMO_DATA=true and NODE_ENV=production.
DEMO_USER_PASSWORD="change-me-demo-password"

# ------------------------------------------------------------------------------
# Client & Web Origin Configuration
# ------------------------------------------------------------------------------
# Allowed web origin for CORS headers.
# Local development: Vite dev server origin.
# Production: Deployed Cloud Run public URL or custom domain.
CLIENT_URL="http://localhost:5173"
