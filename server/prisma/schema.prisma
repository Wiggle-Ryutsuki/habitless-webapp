datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PARTICIPANT
  PROGRAM_MANAGER
}

enum FrequencyType {
  DAILY
  WEEKDAYS
  THREE_TIMES_WEEKLY
  WEEKLY
  MONTHLY
  CUSTOM_DAYS
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(PARTICIPANT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  habits       Habit[]

  @@map("users")
}

model Habit {
  id          Int           @id @default(autoincrement())
  userId      Int
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  colorHex    String        @default("#ff9800")
  frequency   FrequencyType @default(DAILY)
  daysOfWeek  Int[]         @default([1, 2, 3, 4, 5, 6, 7]) // ISO-8601: 1=Mon .. 7=Sun
  startDate   DateTime      @default(now())
  endDate     DateTime?
  targetCount Int           @default(20)
  isActive    Boolean       @default(true)
  programId   Int?          // Reserved for Feature 4 Challenge Program integration
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  logs        HabitLog[]

  @@index([userId, isActive])
  @@map("habits")
}

model HabitLog {
  id        Int      @id @default(autoincrement())
  habitId   Int
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  logDate   DateTime @db.Date // Normalized calendar date YYYY-MM-DD
  completed Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([habitId, logDate])
  @@index([logDate])
  @@map("habit_logs")
}

