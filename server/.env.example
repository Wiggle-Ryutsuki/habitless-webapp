# Server Port and Mode (default 3000; Cloud Run provides PORT in production)
PORT=3000
NODE_ENV=development

# Database connection URL (Cloud SQL provides this in production via Secret Manager)
DATABASE_URL="postgresql://habitless_user:change-me-db-password@localhost:5432/habitless_dev?schema=public"

# JWT Signing Secret (Minimum 32 characters; sourced from Secret Manager in production)
JWT_SECRET="change-me-to-a-secure-random-secret-at-least-32-chars"

# First Program Manager (Admin) password for the seed. Required when NODE_ENV=production.
# Sourced from Secret Manager in production.
ADMIN_PASSWORD="change-me-admin-password"

# Demo data toggle (true locally; optional in production for UAT testing)
SEED_DEMO_DATA=true

# Demo user password for seeded participants. Required when SEED_DEMO_DATA=true in production.
DEMO_USER_PASSWORD="change-me-demo-password"

# Allowed web origin for CORS
CLIENT_URL="http://localhost:5173"


